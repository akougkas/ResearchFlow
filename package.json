{
    "name": "gnosis-tasks",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "node tests/run-tests.js",
        "test:e2e": "node tests/capture-screenshots.js",
        "lint": "eslint src tests sw.js",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "check": "npm test && node tests/check-project.js && npm run lint && npm run format:check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6"
    },
    "engines": {
        "node": ">=20"
    }
}
